# 生产环境 API 地址（仅 npm run build 时读取，注入 import.meta.env.VITE_API_BASE）
# 直连 CloudRun 后端公网域名：CloudBase HTTP 网关会剥离 /api 前缀导致 404，故不走网关
# 不含任何密钥，可安全入库
VITE_API_BASE=https://tower-backend-299223-6-1470711810.sh.run.tcloudbase.com/api

# 会话无操作自动登出：空闲 30 分钟判定失效，剩余 60 秒时弹倒计时提示
VITE_IDLE_TIMEOUT_MINUTES=30
VITE_IDLE_WARNING_SECONDS=60
