classDiagram
    class Project {
        +int id
        +str project_name
        +str factory_name
        +str machine_type
        +str delivery_person
        +int monthly_plan
        +int last_month_output
        +str plan_start_date
        +str plan_end_date
        +str status
        +str risk_level
        +float progress_pct
    }
    class ProjectFilters {
        +str keyword
        +str person
        +str status
        +int page
        +int page_size
    }
    class Pagination {
        +int page
        +int page_size
        +int total
    }
    class DashboardStats {
        +int total_projects
        +int warning_count
        +int delayed_count
        +int total_monthly_plan
        +int normal_count
    }
    class ImportResult {
        +int success
        +int skipped
        +str[] errors
        +str message
    }
    class ProjectStore {
        +Project[] projects
        +Project current
        +object overview
        +bool loading
        +DashboardStats dashboard
        +ProjectFilters filters
        +Pagination pagination
        +loadProjects(filters)
        +loadDashboard()
        +addProject(payload)
        +resetFilters()
    }
    class DispatchImportService {
        +parse_and_import(file_path) ImportResult
    }
    class DbProject {
        +upsert_project(data) tuple
        +get_duplicate_project(...) dict|None
        +init_project_processes(pid, start) void
        +update_project_risk_level(pid) str
        +insert_import_log(...) void
        +get_projects_filtered(...) tuple
    }
    ProjectStore "1" --> "0..*" Project : projects
    ImportResult "1" *-- "0..*" Project : (隐含)建项目
